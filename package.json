{
  "name": "@flisk-sh/fliskos",
  "version": "0.2.0",
  "description": "FliskOS: your Flisk projects, your coding agents and the Flisk apps in one local window",
  "license": "MIT",
  "homepage": "https://github.com/flisk-sh/fliskos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/fliskos.git"
  },
  "bugs": {
    "url": "https://github.com/flisk-sh/fliskos/issues"
  },
  "type": "module",
  "bin": {
    "fliskos": "src/cli.js",
    "flisk-app": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "start:bun": "bun src/cli.js",
    "test": "node --test",
    "test:bun": "bun test test/",
    "test:browser": "node --test browser-checks/*.mjs",
    "build:mac": "./macos/build.sh",
    "install:mac": "./macos/install.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
