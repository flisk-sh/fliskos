/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://flisk.si https://flisk.sh; connect-src https://analytics.flisk.si; style-src 'self' 'unsafe-inline'; img-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://analytics.flisk.si
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/logo.svg /icon-192.png /apple-touch-icon.png /favicon.ico /favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/media/*
  Cache-Control: public, max-age=86400

# The real app inside the page: it uses inline styles, and only this site may frame it.
/demo/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Cache-Control: public, max-age=300
